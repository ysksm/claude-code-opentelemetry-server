# このファイルは ../setup-env.sh が .env にコピーし、空の秘密情報をランダムな値で埋めます。
#   ../setup-env.sh <このディレクトリ名> [SITE_ADDRESS]
# 手で作る場合は cp .env.example .env して、「必須」の値を埋めてください。

# ---- 必須（空のままだと docker compose が止まります）----
# Claude Code が送る Bearer トークン
OTEL_INGEST_TOKEN=
# Grafana の管理者パスワード（ユーザー名は admin）
GRAFANA_ADMIN_PASSWORD=

# ---- よく変えるもの ----
# 入口のホスト名か IP アドレス（Caddy の証明書と Grafana の URL に使う）
SITE_ADDRESS=localhost

# ---- 任意（コメントのままなら右の値が使われます）----
# PROMETHEUS_RETENTION=400d
# LOKI_RETENTION=2160h

# イメージのバージョン（更新はここではなく compose.yaml の既定値を変えてプルリクエストで）
# CADDY_VERSION=2.11.6
# OTELCOL_VERSION=0.162.0
# GRAFANA_VERSION=13.2.3
# PROMETHEUS_VERSION=v3.15.0
# LOKI_VERSION=3.7.8
