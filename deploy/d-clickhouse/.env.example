# コピーして .env にする：cp .env.example .env

# 入口のホスト名（Caddy の証明書に入る名前）。IP アドレスでもよい。
SITE_ADDRESS=otel.example.internal
# Claude Code が送る Bearer トークン（openssl rand -hex 32 などで作る）
OTEL_INGEST_TOKEN=change-me
# Grafana の管理者パスワード
GRAFANA_ADMIN_PASSWORD=change-me

# ClickHouse
CLICKHOUSE_DB=otel
CLICKHOUSE_USER=otel
CLICKHOUSE_PASSWORD=change-me
# テーブルの TTL（17520h = 2 年）。テーブル作成時にだけ反映される。
CLICKHOUSE_TTL=17520h

# イメージのバージョン（更新はここを変えてプルリクエストで）
CADDY_VERSION=2.11.6
OTELCOL_VERSION=0.162.0
CLICKHOUSE_VERSION=26.8.24.9
GRAFANA_VERSION=13.2.3
CLICKHOUSE_PLUGIN_VERSION=4.22.0
